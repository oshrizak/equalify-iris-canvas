# =============================================================================
# Equalify Iris (the conversion service)
# =============================================================================
# Where the connector reaches Iris (without /v1). Recommended: put Iris and
# the connector on one Docker network and use Iris's service name, as below.
# Left commented out, docker compose uses Iris on the host's port 8080
# (http://host.docker.internal:8080) and plain Python uses
# http://localhost:8080. Inside the container "localhost" is the connector
# itself, and a port Iris publishes on 127.0.0.1 only is not reachable from
# containers. Keep Iris on a private address: the connector is its only caller.
# IRIS_API_BASE_URL=http://iris:8080
# Iris's shared secret: the value of server.api_token (IRIS_API_TOKEN) in
# Iris's own .env. Generate with `openssl rand -hex 32`. Required in
# production: Iris has no user accounts, so an open Iris lets anyone who can
# reach it list and read every course document it converted.
IRIS_API_TOKEN=
# How often the bridge polls Iris for session status (seconds).
IRIS_POLL_SECONDS=30
# Pages per Iris session; longer PDFs are cut into parts and stitched back
# together. 0 = the cap Iris publishes at GET /v1/limits (25 today).
IRIS_MAX_PAGES_PER_SESSION=0
# Largest document sent to Iris automatically, in pages (cost guard).
# Longer documents get a "too long" note on the file. 0 = no limit.
IRIS_MAX_DOCUMENT_PAGES=300
# Spend-cap estimate per page, in cents. Iris documents ~10.7 cents a page
# for its suggested model setup; adjust to what your models cost.
IRIS_ESTIMATED_COST_PER_PAGE_CENTS=11
# Close the Iris session when faculty approve a document they did not edit,
# telling Iris a human accepted its output. Off by default: closing makes
# Iris keep a copy of a page image per agent as a regression fixture
# (outside its session retention), which only Iris's feedback loop uses and
# the connector does not. Turn on if you use that loop and accept the copy.
IRIS_CLOSE_SESSIONS_ON_APPROVE=false
# Convert .docx/.pptx to PDF with LibreOffice before sending to Iris.
# The Docker image includes LibreOffice unless built with
# --build-arg WITH_LIBREOFFICE=false.
IRIS_CONVERT_OFFICE_DOCUMENTS=true
# LibreOffice binary and how long one conversion may take (seconds).
# IRIS_SOFFICE_PATH=soffice
# IRIS_SOFFICE_TIMEOUT_SECONDS=180
# Timeouts for Iris calls (seconds). Creating a session waits while Iris
# rasterizes the PDF, so uploads get the longer one.
# IRIS_REQUEST_TIMEOUT_SECONDS=30
# IRIS_UPLOAD_TIMEOUT_SECONDS=300
# Optional: prices per million tokens, to turn Iris's token counts into a
# cost per job (and true up the spend cap). Leave 0 to record tokens only.
IRIS_PRICE_INPUT_PER_MTOK_USD=0
IRIS_PRICE_OUTPUT_PER_MTOK_USD=0
IRIS_PRICE_CACHE_READ_PER_MTOK_USD=0
IRIS_PRICE_CACHE_WRITE_PER_MTOK_USD=0

# =============================================================================
# Legacy: Reflow Core (only while migrating off it)
# =============================================================================
# Documents converted before the switch to Iris were read from Reflow Core on
# every view. Set these while running
#   python -m connector.tools.migrate_reflow_jobs
# (it copies those documents into the connector), then remove them and shut
# Reflow Core down. Leave unset on a fresh install.
REFLOW_API_BASE_URL=
REFLOW_API_KEY=

# =============================================================================
# LTI 1.3
# =============================================================================
LTI_ENABLED=true
# Public URL where this connector is reachable from Canvas. Must be HTTPS in prod.
LTI_PUBLIC_URL=http://localhost:8000

# From the Canvas Developer Key:
LTI_ISSUER=https://canvas.instructure.com
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_AUTH_LOGIN_URL=https://canvas.instructure.com/api/lti/authorize_redirect
LTI_AUTH_TOKEN_URL=https://canvas.instructure.com/login/oauth2/token
LTI_JWKS_URL=https://canvas.instructure.com/api/lti/security/jwks

# OIDC state TTL (seconds) — protects against stale login redirects.
LTI_STATE_TTL_SECONDS=600

# RSA keypair this connector signs LTI JWTs with.
# Generate with scripts/generate_lti_keys.sh.
LTI_PRIVATE_KEY_PATH=/app/keys/lti_private.pem
LTI_PUBLIC_KEY_PATH=/app/keys/lti_public.pem

# =============================================================================
# Canvas API
# =============================================================================
CANVAS_API_URL=https://canvas.instructure.com

# Optional admin fallback token. Per-instructor OAuth tokens (below) are preferred.
CANVAS_API_TOKEN=

# Comma-separated Canvas course IDs the watcher will scan.
CANVAS_WATCHED_COURSES=

# How often (seconds) the watcher polls Canvas for new files.
CANVAS_POLL_SECONDS=300

# Origins allowed to embed the Panorama overlay (comma-separated).
CANVAS_ALLOWED_ORIGINS=https://canvas.instructure.com

# Extra origins allowed to frame the consent page, added to the built-in
# https://*.instructure.com. Needed when Canvas is self-hosted on your own
# domain, or when a tunnel fronts the tool in development. A missing entry
# shows up as a consent page that renders blank inside the Canvas iframe.
# Example: https://*.example.edu,https://*.ngrok-free.dev
CONSENT_EXTRA_FRAME_ANCESTORS=

# Per-instructor OAuth (Canvas Developer Key in OAuth-2 mode).
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=

# =============================================================================
# Multi-tenant
# =============================================================================
# When true, the watcher uses per-instructor OAuth tokens stored in Redis
# instead of the single CANVAS_API_TOKEN above.
MULTI_TENANT_WATCHER=false

# =============================================================================
# Redis (Canvas-side state, eq-pdf:lti:* and eq-pdf:canvas:* keys)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Connector API keys (clients calling THIS service)
# =============================================================================
# Comma-separated allowlist of API keys accepted on protected endpoints.
API_KEYS=

# =============================================================================
# S3 (legacy: presigned URLs returned from Reflow Core; unused with Iris)
# =============================================================================
# Public URL used in faculty-facing links.
S3_PUBLIC_URL=

# Internal URL the connector uses to FETCH results. Required when Reflow Core's
# presigned URLs point at a hostname the connector can't reach by that name —
# canvas/reflow_client.py rewrites the host before fetching.
#
# NOTE: the absence of this field is the bug that broke the bridge on 2026-06-17
# in the source fork. Keep it set whenever S3_PUBLIC_URL ≠ the host the connector
# can actually reach.
S3_INTERNAL_URL=

# =============================================================================
# AI / Translation (optional — Translate alt-format)
# =============================================================================
# When set, the Translate button in the alt-formats modal works. Calls
# Claude Sonnet 4.5 via the Anthropic Messages API. The translator prompt
# is explicitly told to preserve LaTeX math and mhchem chemistry markup
# verbatim, so equations don't get translated into the target language's
# prose.
# Leave empty to surface a clear 503 with setup instructions instead.
ANTHROPIC_API_KEY=

# =============================================================================
# AWS / Audio synthesis (optional — Audio MP3 alt-format)
# =============================================================================
# When set with valid credentials, the Audio (MP3) button in the
# alt-formats modal works. Calls Amazon Polly's neural TTS engine. The
# IAM user needs the ``polly:SynthesizeSpeech`` permission.
# Leave AWS_ACCESS_KEY_ID empty to surface a clear 503 with setup
# instructions instead.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# Publication gate (recommended for production)
# =============================================================================
# When true, the approve handler enforces:
#   * Zero ``error``-severity WCAG findings (or explicit waivers per
#     finding with a justification)
#   * Reviewer checklist items (headings, alt_text, tables,
#     reading_order) confirmed in the approval body
# When false (the default), the checks run but failures are advisory —
# faculty can publish a page with accessibility errors. Production
# deployments should ALWAYS set this to true.
REQUIRE_WCAG_GATE=false

# =============================================================================
# Data retention (recommended for production)
# =============================================================================
# How long the connector keeps each kind of record in Redis before the
# bridge worker's sweeper purges it (set to 0 to disable a sweep). The
# accessibility audit log is the legally sensitive piece — keep it as
# long as your institution's records-retention policy requires.
# Defaults: jobs 90 days, audit log 5 years.
CANVAS_JOB_RETENTION_SECONDS=7776000
CANVAS_AUDIT_RETENTION_SECONDS=157680000

# =============================================================================
# Secrets — MUST be set in production
# =============================================================================
# Generate both with: python -m connector.tools.generate_keys
#
# TOKEN_ENCRYPTION_KEY derives the AES-GCM key that protects instructor
# OAuth tokens at rest. When unset, the connector falls back to
# CSRF_SECRET_KEY → hardcoded constant — anyone with this source can
# decrypt a Redis dump. The startup secrets audit logs CRITICAL when
# this is missing in production.
TOKEN_ENCRYPTION_KEY=
#
# CSRF_SECRET_KEY signs CSRF tokens on every state-changing POST
# (approve, reject, edit, pii-decision, unpublish). When unset, the
# connector derives a stable value from the LTI keypair — works but
# isn't a "secret."
CSRF_SECRET_KEY=
